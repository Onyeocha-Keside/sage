<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sage listens only while you hold the push-to-talk shortcut.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sage turns what you say into text so it can answer you.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows plain http://localhost while testing against `npx wrangler dev`. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
