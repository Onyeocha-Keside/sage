<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prototype of the Windows-only pieces. Windows 11 only, so capture without
       a border and capture exclusion don't need fallbacks for old builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>Sage.Windows</RootNamespace>
    <AssemblyName>SagePrototype</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sage.Core\Sage.Core.csproj" />
  </ItemGroup>
</Project>
