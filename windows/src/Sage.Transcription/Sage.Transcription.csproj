<Project Sdk="Microsoft.NET.Sdk">
  <!-- On-device speech-to-text with sherpa-onnx. Audio never leaves the PC.
       Portable, so the recognizer can be tested on any machine with the real model. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sage.Transcription</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.3" />
  </ItemGroup>
</Project>
