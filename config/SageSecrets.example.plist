<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to leanring-buddy/App/SageSecrets.plist (git-ignored). -->
	<!-- Local testing: http://localhost:8787   Deployed: https://sage-api.YOUR-SUBDOMAIN.workers.dev -->
	<key>WorkerBaseURL</key>
	<string>http://localhost:8787</string>
	<!-- Must match the Worker's SAGE_APP_KEY secret. Generate one with: openssl rand -hex 24 -->
	<key>AppKey</key>
	<string>paste-your-app-key-here</string>
</dict>
</plist>
